{
  "name": "@soroscan/sdk",
  "version": "0.1.0",
  "description": "TypeScript/JavaScript client SDK for the SoroScan API",
  "keywords": [
    "stellar",
    "soroban",
    "soroscan",
    "blockchain",
    "sdk"
  ],
  "homepage": "https://github.com/SoroScan/soroscan/tree/main/sdk/typescript",
  "repository": {
    "type": "git",
    "url": "https://github.com/SoroScan/soroscan.git",
    "directory": "sdk/typescript"
  },
  "license": "MIT",
  "author": "SoroScan Contributors",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/esm/hooks/index.d.ts",
        "default": "./dist/esm/hooks/index.js"
      },
      "require": {
        "types": "./dist/cjs/hooks/index.d.ts",
        "default": "./dist/cjs/hooks/index.cjs"
      }
    }
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "graphql-codegen --config codegen.ts",
    "build": "npm run generate && npm run build:esm && npm run build:cjs && npm run build:cjs:rename",
    "build:esm": "tsc -p tsconfig.json --outDir dist/esm --module esnext --moduleResolution bundler --declaration --declarationDir dist/esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:cjs:rename": "node scripts/rename-cjs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pact": "vitest run test/pact",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit --strict --strictNullChecks",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@apollo/client": "^3.14.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/typescript": "^4.0.0",
    "@pact-foundation/pact": "^13.2.0",
    "@types/node": "^22.0.0",
    "graphql": "^16.12.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@apollo/client": "^3.8.0",
    "graphql": "^16.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "graphql": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
